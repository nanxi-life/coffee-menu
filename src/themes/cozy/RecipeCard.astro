---
import type { Recipe } from '../../utils/recipes';
import { withBase } from '../../utils/paths';

interface Props {
  recipe: Recipe;
}

const { recipe } = Astro.props;
const detailUrl = withBase(`/recipe/${recipe.id.replace(/\/index\.md$/, '')}`);
---

<a href={detailUrl} class="recipe-card" data-category={recipe.data.category} data-search={`${recipe.data.title} ${recipe.data.category} ${recipe.body}`}>
  <img src={withBase(recipe.data.image)} alt={recipe.data.title} class="recipe-card-image" />
  <div class="recipe-card-body">
    <span class="recipe-card-category">{recipe.data.category}</span>
    <h3 class="recipe-card-title">{recipe.data.title}</h3>
    {recipe.data.prepTime && <p class="recipe-card-meta">⏱ {recipe.data.prepTime}</p>}
  </div>
</a>
