---
import type { Recipe } from '../../utils/recipes';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { withBase } from '../../utils/paths';

interface Props {
  recipe: Recipe;
  Content: AstroComponentFactory;
}

const { recipe, Content } = Astro.props;
---

<div class="container recipe-detail">
  <a href={withBase('/')} class="back-link">← 返回首页</a>

  <div class="recipe-detail-header">
    <h1 class="recipe-detail-title">{recipe.data.title}</h1>
    <div class="recipe-detail-meta">
      <span>{recipe.data.category}</span>
      {recipe.data.prepTime && <span>⏱ {recipe.data.prepTime}</span>}
    </div>
  </div>

  <img src={withBase(recipe.data.image)} alt={recipe.data.title} class="recipe-detail-image" />

  <div class="recipe-detail-section">
    <h2>介绍</h2>
    <Content />
  </div>

  {recipe.data.ingredients && recipe.data.ingredients.length > 0 && (
    <div class="recipe-detail-section">
      <h2>配比</h2>
      <ul class="ingredients-list">
        {recipe.data.ingredients.map((ing) => (
          <li>
            <span>{ing.item}</span>
            <span>{ing.amount}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  {recipe.data.steps && recipe.data.steps.length > 0 && (
    <div class="recipe-detail-section">
      <h2>制作步骤</h2>
      <ol class="steps-list">
        {recipe.data.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </div>
  )}
</div>
