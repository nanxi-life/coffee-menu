---
import type { Recipe } from '../../utils/recipes';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { withBase } from '../../utils/paths';

interface Props {
  recipe: Recipe;
  Content: AstroComponentFactory;
}

const { recipe, Content } = Astro.props;
---

<div class="container recipe-detail">
  <div class="detail-topline"><a href={withBase('/#archive')} class="back-link">← Back to archive</a><span>Field note / {recipe.data.category}</span></div>

  <header class="recipe-detail-header">
    <p class="eyebrow">Coffee experiment</p>
    <h1 class="recipe-detail-title">{recipe.data.title}</h1>
    <div class="recipe-detail-meta"><span>{recipe.data.category}</span>{recipe.data.prepTime && <span>制作时间 {recipe.data.prepTime}</span>}</div>
  </header>

  <div class="recipe-detail-layout">
    <div class="recipe-detail-visual">
      <img src={withBase(recipe.data.image)} alt={recipe.data.title} class="recipe-detail-image" />
      <p class="image-caption">A study in texture, temperature and time.<br />Nanxi Coffee Journal / {recipe.data.category}</p>
    </div>

    <div class="recipe-detail-content">
      {recipe.data.ingredients && recipe.data.ingredients.length > 0 && (
        <section class="recipe-detail-section">
          <div class="section-heading">
            <span class="section-index">01</span>
            <h2>配比 / Recipe</h2>
          </div>
          <ul class="ingredients-list">
            {recipe.data.ingredients.map((ing) => (
              <li>
                <span>{ing.item}</span>
                <span>{ing.amount}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>

  <div class="recipe-detail-lower">
    <section class="recipe-detail-section">
      <div class="section-heading">
        <span class="section-index">02</span>
        <h2>Story</h2>
      </div>
      <div class="recipe-prose">
        <Content />
      </div>
    </section>

    {recipe.data.steps && recipe.data.steps.length > 0 && (
      <section class="recipe-detail-section">
        <div class="section-heading">
          <span class="section-index">03</span>
          <h2>Method</h2>
        </div>
        <ol class="steps-list">
          {recipe.data.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </section>
    )}
  </div>
</div>
