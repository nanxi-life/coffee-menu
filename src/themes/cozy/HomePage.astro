---
import RecipeCard from './RecipeCard.astro';
import type { Recipe } from '../../utils/recipes';
import { withBase } from '../../utils/paths';
import { HERO_IMAGES } from '../../generated/hero-images';

interface Props {
  title: string;
  description: string;
  recipes: Recipe[];
  categories: string[];
}

const { title, description, recipes, categories } = Astro.props;

const heroCandidates = HERO_IMAGES.map((asset) => ({
  asset,
  recipe: recipes.find((recipe) => recipe.data.image === asset.source),
})).filter((candidate): candidate is typeof candidate & { recipe: Recipe } => Boolean(candidate.recipe));
const heroAssets = heroCandidates.map(({ asset, recipe }) => ({
  id: recipe.id,
  title: recipe.data.title,
  href: withBase(`/recipe/${recipe.id.replace(/\/index\.md$/, '')}`),
  thumb: withBase(asset.thumb),
  orientation: asset.orientation,
}));

// 胶片墙:完全随机洗牌后按奇偶分成两列,不做横竖分组
function shuffle<T>(items: T[]) {
  const shuffled = [...items];
  for (let index = shuffled.length - 1; index > 0; index -= 1) {
    const swapIndex = Math.floor(Math.random() * (index + 1));
    [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
  }
  return shuffled;
}
const shuffledAssets = shuffle(heroAssets);
const filmColumns = [
  shuffledAssets.filter((_, index) => index % 2 === 0),
  shuffledAssets.filter((_, index) => index % 2 === 1),
];
const filmDurations = [28, 38];
---

<div class="home-page">
  <section class="hero-stage" aria-labelledby="journal-title">
    <div class="hero-canvas">
      <div class="hero-films">
        {filmColumns.map((column, columnIndex) => (
          <div class={`film-column${columnIndex % 2 === 1 ? ' film-column--reverse' : ''}`}>
            <div class="film-track" style={`animation-duration: ${filmDurations[columnIndex % filmDurations.length]}s`}>
              {[false, true].map((isDuplicate) => (
                <div class="film-half" aria-hidden={isDuplicate ? 'true' : undefined}>
                  {column.map((asset) => (
                    <a
                      href={asset.href}
                      tabindex={-1}
                      class={`film-item ${asset.orientation}`}
                      aria-label={isDuplicate ? undefined : `View ${asset.title}`}
                    >
                      <img src={asset.thumb} alt={isDuplicate ? '' : asset.title} loading="eager" decoding="async" />
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="hero-center">
        <p class="eyebrow">A personal coffee archive</p>
        <h1 id="journal-title">{title.replace(' Coffee Journal', '')}<br /><em>Coffee Journal</em></h1>
        <p class="hero-description">{description}</p>
        <div class="hero-actions">
          <a href="#archive" class="scroll-cue">Explore the archive <span>↓</span></a>
          <span class="hero-count">{recipes.length} works collected</span>
        </div>
      </div>
    </div>
  </section>

  <nav class="nav home-nav" aria-label="主导航">
    <div class="container nav-inner">
      <a href={withBase('/')} class="wordmark">NANXI <span>COFFEE JOURNAL</span></a>
      <div class="nav-links">
        <a href="#archive">Archive</a>
        <span class="nav-issue">No. 01 / 2026</span>
      </div>
    </div>
  </nav>

  <section class="archive container" id="archive" aria-labelledby="archive-title">
    <div class="archive-heading">
      <div>
        <p class="eyebrow">The coffee archive</p>
        <h2 id="archive-title">Small experiments,<br /><em>quietly recorded.</em></h2>
      </div>
      <p class="archive-intro">Recipes, ingredients and moments from a home coffee practice. Browse by feeling, flavour or method.</p>
    </div>
    <div class="archive-tools">
      <label class="search-field">
        <span class="search-mark">⌕</span>
        <span class="sr-only">搜索菜谱</span>
        <input type="text" class="search-input" placeholder="Search the journal" id="recipe-search" aria-label="搜索咖啡、原料、做法" />
      </label>
      <div class="category-filter" id="category-filter" role="group" aria-label="菜谱分类">
        <button class="category-btn active" data-category="all" aria-pressed="true">All</button>
        {categories.map((category) => <button class="category-btn" data-category={category} aria-pressed="false">{category}</button>)}
      </div>
      <span class="archive-count" id="hero-stat" aria-live="polite"><strong id="recipe-count">{recipes.length}</strong> entries</span>
    </div>
    <div class="recipe-grid" id="recipe-grid">
      {recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
    </div>
  </section>

  <div class="empty-state" id="empty-state" style="display: none;">
    没有找到匹配的菜谱，换个关键词试试？
  </div>
</div>

<script>
  // 仅站内锚点平滑滚动:避免影响浏览器返回时的滚动位置恢复
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('a[href="#archive"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      document.getElementById('archive')?.scrollIntoView({
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
        block: 'start',
      });
    });
  });

  // 刷新时回到顶部:清除锚点、取消焦点恢复(否则浏览器会把焦点恢复到轮播图链接并滚过去)
  const resetOnReload = () => {
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    if (nav?.type !== 'reload') return;
    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
    if (document.activeElement && document.activeElement !== document.body) {
      (document.activeElement as HTMLElement).blur();
    }
    window.scrollTo(0, 0);
  };
  window.addEventListener('load', resetOnReload);
  window.addEventListener('pageshow', () => {
    resetOnReload();
    window.setTimeout(resetOnReload, 0);
    window.setTimeout(resetOnReload, 250);
  });

  // 移动端:横向胶片自动播放 + 手指拖拽(带惯性、无缝循环),松手后恢复自动播放
  const filmMedia = window.matchMedia('(max-width: 820px)');
  const filmColumn = document.querySelector('.film-column') as HTMLElement | null;
  const filmTrack = filmColumn?.querySelector('.film-track') as HTMLElement | null;
  let filmDragCleanup: (() => void) | null = null;

  function enableFilmDrag() {
    if (filmDragCleanup || !filmColumn || !filmTrack) return;
    let offset = 0;
    let velocity = 0;
    let lastX = 0;
    let lastTime = 0;
    let dragging = false;
    let moved = 0;
    let autoFrame = 0;
    let inertiaFrame = 0;
    let resumeTimer = 0;
    let lastAutoTime = performance.now();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const loopWidth = () => (filmTrack.scrollWidth + 14) / 2;
    const applyOffset = () => {
      const loop = loopWidth();
      offset = ((offset % loop) + loop) % loop - loop;
      filmTrack.style.transform = `translate3d(${offset}px, 0, 0)`;
    };

    const stopAuto = () => {
      cancelAnimationFrame(autoFrame);
      window.clearTimeout(resumeTimer);
    };
    const startAuto = () => {
      stopAuto();
      cancelAnimationFrame(inertiaFrame);
      lastAutoTime = performance.now();
      let rampFrames = 0;
      const step = (now: number) => {
        const dt = Math.min(50, now - lastAutoTime);
        lastAutoTime = now;
        rampFrames += 1;
        const ramp = 1 - Math.pow(0.94, rampFrames);
        offset -= (loopWidth() / 28) * (dt / 1000) * ramp;
        applyOffset();
        autoFrame = requestAnimationFrame(step);
      };
      autoFrame = requestAnimationFrame(step);
    };
    const scheduleAutoResume = () => {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(startAuto, 600);
    };

    const onPointerDown = (event: PointerEvent) => {
      dragging = true;
      moved = 0;
      velocity = 0;
      lastX = event.clientX;
      lastTime = performance.now();
      stopAuto();
      cancelAnimationFrame(inertiaFrame);
      filmColumn.setPointerCapture(event.pointerId);
    };
    const onPointerMove = (event: PointerEvent) => {
      if (!dragging) return;
      const now = performance.now();
      const delta = event.clientX - lastX;
      velocity = delta / Math.max(1, now - lastTime);
      lastX = event.clientX;
      lastTime = now;
      offset += delta;
      moved += Math.abs(delta);
      applyOffset();
    };
    const onPointerEnd = () => {
      if (!dragging) return;
      dragging = false;
      if (Math.abs(velocity) > 0.05) {
        const step = () => {
          velocity *= 0.94;
          offset += velocity * 16;
          applyOffset();
          if (Math.abs(velocity) > 0.02) inertiaFrame = requestAnimationFrame(step);
          else scheduleAutoResume();
        };
        inertiaFrame = requestAnimationFrame(step);
      } else {
        scheduleAutoResume();
      }
    };
    const onClick = (event: MouseEvent) => {
      if (moved > 6) {
        event.preventDefault();
        event.stopPropagation();
      }
    };

    filmColumn.addEventListener('pointerdown', onPointerDown);
    filmColumn.addEventListener('pointermove', onPointerMove);
    filmColumn.addEventListener('pointerup', onPointerEnd);
    filmColumn.addEventListener('pointercancel', onPointerEnd);
    filmColumn.addEventListener('click', onClick, true);

    if (!reduceMotion) startAuto();

    filmDragCleanup = () => {
      stopAuto();
      cancelAnimationFrame(inertiaFrame);
      filmColumn.removeEventListener('pointerdown', onPointerDown);
      filmColumn.removeEventListener('pointermove', onPointerMove);
      filmColumn.removeEventListener('pointerup', onPointerEnd);
      filmColumn.removeEventListener('pointercancel', onPointerEnd);
      filmColumn.removeEventListener('click', onClick, true);
      filmTrack.style.transform = '';
    };
  }

  if (filmMedia.matches) enableFilmDrag();
  filmMedia.addEventListener('change', () => {
    if (filmMedia.matches) enableFilmDrag();
    else {
      filmDragCleanup?.();
      filmDragCleanup = null;
    }
  });

  const searchInput = document.getElementById('recipe-search') as HTMLInputElement;
  const categoryButtons = document.querySelectorAll('.category-btn');
  const recipeCards = document.querySelectorAll('.recipe-card');
  const emptyState = document.getElementById('empty-state');
  const grid = document.getElementById('recipe-grid');
  const recipeCount = document.getElementById('recipe-count');
  const heroStat = document.getElementById('hero-stat');

  let activeCategory = 'all';
  let activeQuery = '';

  function filter() {
    let visibleCount = 0;
    recipeCards.forEach((card) => {
      const el = card as HTMLElement;
      const category = el.dataset.category || '';
      const searchData = (el.dataset.search || '').toLowerCase();
      const matchesCategory = activeCategory === 'all' || category === activeCategory;
      const matchesSearch = searchData.includes(activeQuery.toLowerCase());

      if (matchesCategory && matchesSearch) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (emptyState && grid) {
      if (visibleCount === 0) {
        emptyState.style.display = 'block';
        grid.style.display = 'none';
      } else {
        emptyState.style.display = 'none';
        grid.style.display = '';
      }
    }

    if (recipeCount && heroStat) {
      recipeCount.textContent = String(visibleCount);
      heroStat.setAttribute('aria-label', `${visibleCount} recipes collected`);
    }
  }

  searchInput?.addEventListener('input', (event) => {
    activeQuery = (event.target as HTMLInputElement).value;
    filter();
  });

  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      categoryButtons.forEach((item) => {
        item.classList.remove('active');
        item.setAttribute('aria-pressed', 'false');
      });
      button.classList.add('active');
      button.setAttribute('aria-pressed', 'true');
      activeCategory = (button as HTMLElement).dataset.category || 'all';
      filter();
    });
  });
</script>
